        "func": "const apiKey = msg.req.headers[\"x-api-key\"];\nconst kunciBenar = \"IOT-UNISKA-2026-FARLINA\";\n\nif (apiKey === kunciBenar) {\n    return [msg, null];\n} else {\n    msg.statusCode = 401;\n    msg.payload = {\n        status: \"error\",\n        message: \"API Key tidak valid atau tidak ditemukan\"\n    };\n\n    return [null, msg];\n}",
