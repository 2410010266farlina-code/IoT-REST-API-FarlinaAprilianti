    {
        "id": "d7a7eb376133e2c5",
        "type": "function",
        "z": "e366318a47be5ad8",
        "name": "Set Threshold Suhu",
        "func": "\nconst batas = Number(msg.payload.threshold);\n\nif (\n    msg.payload.threshold === undefined ||\n    !Number.isFinite(batas) ||\n    batas <= 0\n) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Batas suhu harus berupa angka lebih dari 0\"\n    };\n    return msg;\n}\n\n// Simpan batas suhu ke flow context\nflow.set(\"thresholdSuhu\", batas);\n\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil diperbarui\",\n    threshold: batas\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 520,
        "wires": [
