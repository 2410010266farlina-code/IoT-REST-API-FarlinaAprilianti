    {
        "id": "f6e6aaed0df95719",
        "type": "function",
        "z": "e366318a47be5ad8",
        "name": "Cek Threshold Suhu",
        "func": "const batas = flow.get(\"thresholdSuhu\");\n\nif (batas === undefined) {\n    return null;\n}\n\nconst suhu = Number(msg.payload.suhu);\n\nif (suhu > batas) {\n    msg.payload = {\n        status: \"warning\",\n        message: \"PERINGATAN! Suhu melewati batas!\",\n        suhu: suhu,\n        batas: batas\n    };\n\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
